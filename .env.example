# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Para descobrir seu username: publique qualquer prompt no LangSmith Hub, depois abra-o e clique no ícone de cadeado (🔒) para ver seu username.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration (ou OpenRouter — ver abaixo)
OPENAI_API_KEY=

# Para usar OpenRouter (Gemini sem rate limit do free tier direto):
# OPENAI_API_KEY=sk-or-v1-...
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Google Gemini Configuration
GOOGLE_API_KEY=

# LLM Configuration
# OpenRouter: LLM_PROVIDER=openai, LLM_MODEL=google/gemini-2.5-flash
# Gemini direto: LLM_PROVIDER=google, LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=openai
LLM_MODEL=google/gemini-2.5-flash
EVAL_MODEL=google/gemini-2.5-flash