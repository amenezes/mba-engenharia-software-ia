# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Para descobrir seu username: publique qualquer prompt no LangSmith Hub, depois abra-o e clique no ícone de cadeado (🔒) para ver seu username.
USERNAME_LANGSMITH_HUB=

# ============================================================
# Provider DEFAULT: Google Gemini
# Gratuito: 15 req/min, 1500 req/dia — suficiente para o desafio
# Obtenha em: https://aistudio.google.com/app/apikey
# ============================================================
GOOGLE_API_KEY=

# LLM Configuration (default: Google Gemini)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EVAL_MODEL=gemini-2.5-flash

# ============================================================
# Alternativa OFICIAL: OpenAI
# Descomente e preencha para usar (sobrescreve o default acima)
# ============================================================
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EVAL_MODEL=gpt-4o

# ============================================================
# PLUS OPCIONAL: OpenRouter (Gemini sem rate limit do free tier)
# Descomente para contornar o limite de requisições do Gemini direto
# Obtenha em: https://openrouter.ai/keys
# ============================================================
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# LLM_PROVIDER=openai
# LLM_MODEL=google/gemini-2.5-flash
# EVAL_MODEL=google/gemini-2.5-flash